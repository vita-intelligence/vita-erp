  "descriptions": {
    "decimal_separator": "\u092a\u0942\u0930\u094d\u0923\u093e\u0902\u0915 \u0914\u0930 \u0926\u0936\u092e\u0932\u0935 \u092d\u093e\u0917 \u0915\u0947 \u092c\u0940\u091a \u0915\u093e \u0905\u0915\u094d\u0937\u0930\u0964 \u0909\u0926\u093e.: 1234.56 (\u092c\u093f\u0902\u0926\u0941) \u092f\u093e 1234,56 (\u0905\u0932\u094d\u092a\u0935\u093f\u0930\u093e\u092e)\u0964",
    "thousands_separator": "\u092a\u0920\u0928\u0940\u092f\u0924\u093e \u0915\u0947 \u0932\u093f\u090f \u0905\u0902\u0915\u094b\u0902 \u0915\u094b \u0938\u092e\u0942\u0939\u093f\u0924 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u093e \u0905\u0915\u094d\u0937\u0930\u0964 \u0909\u0926\u093e.: 1,234 (\u0905\u0932\u094d\u092a\u0935\u093f\u0930\u093e\u092e) \u092f\u093e 1.234 (\u092c\u093f\u0902\u0926\u0941)\u0964",
    "digit_grouping": "\u0905\u0902\u0915 \u0915\u0948\u0938\u0947 \u0938\u092e\u0942\u0939\u093f\u0924 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902\u0964 \u092e\u093e\u0928\u0915: 1,234,567\u0964 \u092d\u093e\u0930\u0924\u0940\u092f: 12,34,567 (\u0932\u093e\u0916 \u0914\u0930 \u0915\u0930\u094b\u0921\u093c)\u0964",
    "quantity_precision": "\u0906\u0907\u091f\u092e \u092e\u093e\u0924\u094d\u0930\u093e\u0913\u0902 \u0915\u0947 \u0932\u093f\u090f \u0926\u0936\u092e\u0932\u0935 \u0938\u094d\u0925\u093e\u0928\u094b\u0902 \u0915\u0940 \u0938\u0902\u0916\u094d\u092f\u093e (\u0909\u0926\u093e.: 2.5 kg \u092f\u093e 2.5000 kg)\u0964",
    "price_precision": "\u0911\u0930\u094d\u0921\u0930 \u0914\u0930 \u0907\u0928\u0935\u0949\u0907\u0938 \u092a\u0930 \u0907\u0915\u093e\u0908 \u092e\u0942\u0932\u094d\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0926\u0936\u092e\u0932\u0935 \u0938\u094d\u0925\u093e\u0928\u094b\u0902 \u0915\u0940 \u0938\u0902\u0916\u094d\u092f\u093e\u0964",
    "currency_precision": "\u092e\u094c\u0926\u094d\u0930\u093f\u0915 \u0915\u0941\u0932 \u092f\u094b\u0917 \u0915\u0947 \u0932\u093f\u090f \u0926\u0936\u092e\u0932\u0935 \u0938\u094d\u0925\u093e\u0928\u094b\u0902 \u0915\u0940 \u0938\u0902\u0916\u094d\u092f\u093e\u0964 JPY 0 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u093e \u0939\u0948, KWD 3 \u0915\u093e\u0964",
    "exchange_rate_precision": "\u092e\u0941\u0926\u094d\u0930\u093e \u0935\u093f\u0928\u093f\u092e\u092f \u0926\u0930\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0926\u0936\u092e\u0932\u0935 \u0938\u094d\u0925\u093e\u0928\u094b\u0902 \u0915\u0940 \u0938\u0902\u0916\u094d\u092f\u093e\u0964 \u0905\u0927\u093f\u0915 = \u0905\u0927\u093f\u0915 \u0938\u091f\u0940\u0915 \u0930\u0942\u092a\u093e\u0902\u0924\u0930\u0923\u0964",
    "percentage_precision": "\u0915\u0930 \u0926\u0930\u094b\u0902 \u0914\u0930 \u091b\u0942\u091f \u091c\u0948\u0938\u0947 \u092a\u094d\u0930\u0924\u093f\u0936\u0924\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0926\u0936\u092e\u0932\u0935 \u0938\u094d\u0925\u093e\u0928\u094b\u0902 \u0915\u0940 \u0938\u0902\u0916\u094d\u092f\u093e\u0964",
    "weight_precision": "\u0907\u0928\u094d\u0935\u0947\u0902\u091f\u094d\u0930\u0940 \u0914\u0930 \u0909\u0924\u094d\u092a\u093e\u0926\u0928 \u092e\u0947\u0902 \u0935\u091c\u0928 \u092e\u093e\u0928\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0926\u0936\u092e\u0932\u0935 \u0938\u094d\u0925\u093e\u0928\u094b\u0902 \u0915\u0940 \u0938\u0902\u0916\u094d\u092f\u093e\u0964",
    "currency_symbol_position": "\u092e\u0941\u0926\u094d\u0930\u093e \u092a\u094d\u0930\u0924\u0940\u0915 \u0930\u093e\u0936\u093f \u0915\u0947 \u0938\u093e\u092a\u0947\u0915\u094d\u0937 \u0915\u0939\u093e\u0901 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u0909\u0926\u093e.: $100 (\u092a\u0939\u0932\u0947) \u092f\u093e 100\u20ac (\u092c\u093e\u0926 \u092e\u0947\u0902)\u0964",
    "currency_spacing": "\u092e\u0941\u0926\u094d\u0930\u093e \u092a\u094d\u0930\u0924\u0940\u0915 \u0914\u0930 \u0930\u093e\u0936\u093f \u0915\u0947 \u092c\u0940\u091a \u0930\u093f\u0915\u094d\u0924\u093f \u091c\u094b\u0921\u093c\u0947\u0902\u0964 \u0909\u0926\u093e.: $100 \u092f\u093e 100\u20ac \u0915\u0947 \u092c\u091c\u093e\u092f $ 100 \u092f\u093e 100 \u20ac\u0964",
    "negative_format": "\u090b\u0923\u093e\u0924\u094d\u092e\u0915 \u0938\u0902\u0916\u094d\u092f\u093e\u090f\u0901 \u0915\u0948\u0938\u0947 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0939\u094b\u0924\u0940 \u0939\u0948\u0902\u0964 \u0932\u0947\u0916\u093e \u092b\u0949\u0930\u094d\u092e\u0947\u091f \u0915\u094b\u0937\u094d\u0920\u0915 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u093e \u0939\u0948: -100 \u0915\u0947 \u092c\u091c\u093e\u092f (100)\u0964",
    "rounding_method": "\u0917\u0923\u0928\u093e \u0915\u093f\u090f \u0917\u090f \u092e\u093e\u0928\u094b\u0902 \u0915\u094b \u0915\u0948\u0938\u0947 \u092a\u0942\u0930\u094d\u0923\u093e\u0902\u0915\u093f\u0924 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u092c\u0948\u0902\u0915\u0930\u094d\u0938 \u092a\u0942\u0930\u094d\u0923\u093e\u0902\u0915\u0928 (\u0906\u0927\u093e \u0938\u092e) \u0938\u0902\u091a\u092f\u0940 \u092a\u0942\u0930\u094d\u0923\u093e\u0902\u0915\u0928 \u092a\u0942\u0930\u094d\u0935\u093e\u0917\u094d\u0930\u0939 \u0915\u094b \u0915\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964",
    "cash_rounding_enabled": "\u0928\u0915\u0926 \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0941\u0932 \u092f\u094b\u0917 \u0915\u094b \u0928\u093f\u0915\u091f\u0924\u092e \u092d\u094c\u0924\u093f\u0915 \u092e\u0942\u0932\u094d\u092f\u0935\u0930\u094d\u0917 \u0924\u0915 \u092a\u0942\u0930\u094d\u0923\u093e\u0902\u0915\u093f\u0924 \u0915\u0930\u0947\u0902\u0964 \u0909\u0926\u093e.: \u0938\u094d\u0935\u093f\u091f\u094d\u091c\u0930\u0932\u0948\u0902\u0921 0.05 CHF \u0924\u0915 \u092a\u0942\u0930\u094d\u0923\u093e\u0902\u0915\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",
    "cash_rounding_increment": "\u092a\u0942\u0930\u094d\u0923\u093e\u0902\u0915\u0928 \u0915\u0947 \u0932\u093f\u090f \u0938\u092c\u0938\u0947 \u091b\u094b\u091f\u093e \u0928\u0915\u0926 \u092e\u0942\u0932\u094d\u092f\u0935\u0930\u094d\u0917\u0964 \u0909\u0926\u093e.: 0.05 (\u0928\u093f\u0915\u0932), 0.10 (\u0921\u093e\u0907\u092e) \u092f\u093e 1.00 (\u092a\u0942\u0930\u094d\u0923 \u0907\u0915\u093e\u0907\u092f\u093e\u0901)\u0964",
    "date_format": "\u0938\u093f\u0938\u094d\u091f\u092e \u092e\u0947\u0902 \u0939\u0930 \u091c\u0917\u0939 \u0926\u093f\u0928\u093e\u0902\u0915 \u0915\u0948\u0938\u0947 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902\u0964 \u0906\u0902\u0924\u0930\u093f\u0915 \u0930\u0942\u092a \u0938\u0947 \u0926\u093f\u0928\u093e\u0902\u0915 \u0938\u0902\u0917\u094d\u0930\u0939\u0923 \u092a\u0930 \u092a\u094d\u0930\u092d\u093e\u0935 \u0928\u0939\u0940\u0902 \u0921\u093e\u0932\u0924\u093e\u0964",
    "time_format": "12-\u0918\u0902\u091f\u093e \u092b\u0949\u0930\u094d\u092e\u0947\u091f AM/PM \u0926\u093f\u0916\u093e\u0924\u093e \u0939\u0948 (2:30 PM)\u0964 24-\u0918\u0902\u091f\u093e \u092b\u0949\u0930\u094d\u092e\u0947\u091f \u0938\u0948\u0928\u094d\u092f \u0938\u092e\u092f \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u093e \u0939\u0948 (14:30)\u0964",
    "week_start_day": "\u0915\u0948\u0932\u0947\u0902\u0921\u0930 \u0914\u0930 \u0938\u093e\u092a\u094d\u0924\u093e\u0939\u093f\u0915 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u092e\u0947\u0902 \u0938\u092a\u094d\u0924\u093e\u0939 \u0915\u093e \u092a\u0939\u0932\u093e \u0926\u093f\u0928\u0964 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u092d\u093f\u0928\u094d\u0928 \u0939\u094b\u0924\u093e \u0939\u0948\u0964",
    "calendar_system": "\u0926\u093f\u0928\u093e\u0902\u0915 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u092f\u094b\u0917 \u0915\u093f\u092f\u093e \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u093e \u0915\u0948\u0932\u0947\u0902\u0921\u0930\u0964 \u0906\u0902\u0924\u0930\u093f\u0915 \u0938\u0902\u0917\u094d\u0930\u0939\u0923 \u0939\u092e\u0947\u0936\u093e \u0917\u094d\u0930\u0947\u0917\u094b\u0930\u093f\u092f\u0928 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0939\u093f\u091c\u0930\u0940 \u0938\u090a\u0926\u0940 \u0905\u0930\u092c \u092e\u0947\u0902 \u0906\u092e \u0939\u0948\u0964",
    "measurement_system": "\u0938\u0902\u0917\u0920\u0928 \u0915\u0947 \u0932\u093f\u090f \u0921\u093f\u092b\u0949\u0932\u094d\u091f \u0907\u0915\u093e\u0908 \u092a\u094d\u0930\u0923\u093e\u0932\u0940\u0964 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u092b\u093c\u0940\u0932\u094d\u0921 \u0905\u092d\u0940 \u092d\u0940 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0907\u0915\u093e\u0908 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",
    "default_weight_uom": "\u0928\u090f \u0906\u0907\u091f\u092e \u092f\u093e \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u092c\u0928\u093e\u0924\u0947 \u0938\u092e\u092f \u092a\u0942\u0930\u094d\u0935-\u091a\u092f\u0928\u093f\u0924 \u0921\u093f\u092b\u0949\u0932\u094d\u091f \u0935\u091c\u0928 \u0907\u0915\u093e\u0908\u0964",
    "default_length_uom": "\u0928\u090f \u0906\u0907\u091f\u092e\u094b\u0902 \u0915\u0947 \u0906\u092f\u093e\u092e\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u092a\u0942\u0930\u094d\u0935-\u091a\u092f\u0928\u093f\u0924 \u0921\u093f\u092b\u0949\u0932\u094d\u091f \u0932\u0902\u092c\u093e\u0908 \u0907\u0915\u093e\u0908\u0964",
    "default_volume_uom": "\u0924\u0930\u0932 \u092f\u093e \u0925\u094b\u0915 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0915\u0947 \u0932\u093f\u090f \u092a\u0942\u0930\u094d\u0935-\u091a\u092f\u0928\u093f\u0924 \u0921\u093f\u092b\u0949\u0932\u094d\u091f \u0906\u092f\u0924\u0928 \u0907\u0915\u093e\u0908\u0964",
    "default_temperature_uom": "\u0915\u094b\u0932\u094d\u0921 \u091a\u0947\u0928, \u0916\u093e\u0926\u094d\u092f \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0914\u0930 \u092a\u0930\u094d\u092f\u093e\u0935\u0930\u0923 \u0928\u093f\u0917\u0930\u093e\u0928\u0940 \u0915\u0947 \u0932\u093f\u090f \u0921\u093f\u092b\u0949\u0932\u094d\u091f \u0924\u093e\u092a\u092e\u093e\u0928 \u0907\u0915\u093e\u0908\u0964",
    "default_area_uom": "\u0917\u094b\u0926\u093e\u092e \u0938\u094d\u0925\u093e\u0928 \u0914\u0930 \u0909\u0924\u094d\u092a\u093e\u0926\u0928 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0921\u093f\u092b\u0949\u0932\u094d\u091f \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u092b\u0932 \u0907\u0915\u093e\u0908\u0964",
    "fiscal_year_start_month": "\u0935\u0939 \u092e\u0939\u0940\u0928\u093e \u091c\u092c \u0906\u092a\u0915\u093e \u0935\u093f\u0924\u094d\u0924\u0940\u092f \u0935\u0930\u094d\u0937 \u0936\u0941\u0930\u0942 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0909\u0926\u093e.: \u092f\u0942\u0915\u0947/\u092d\u093e\u0930\u0924 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u094d\u0930\u0948\u0932, \u0911\u0938\u094d\u091f\u094d\u0930\u0947\u0932\u093f\u092f\u093e \u0915\u0947 \u0932\u093f\u090f \u091c\u0941\u0932\u093e\u0908\u0964",
    "fiscal_year_start_day": "\u092e\u0939\u0940\u0928\u0947 \u0915\u093e \u0935\u0939 \u0926\u093f\u0928 \u091c\u092c \u0906\u092a\u0915\u093e \u0935\u093f\u0924\u094d\u0924\u0940\u092f \u0935\u0930\u094d\u0937 \u0936\u0941\u0930\u0942 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0909\u0926\u093e.: \u092f\u0942\u0915\u0947 6 \u0905\u092a\u094d\u0930\u0948\u0932 \u0938\u0947 \u0936\u0941\u0930\u0942 \u0939\u094b\u0924\u093e \u0939\u0948\u0964",
    "fiscal_calendar_type": "\u092e\u093e\u0928\u0915 \u0915\u0948\u0932\u0947\u0902\u0921\u0930 \u092e\u093e\u0939 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0916\u0941\u0926\u0930\u093e \u0915\u0948\u0932\u0947\u0902\u0921\u0930 (4-4-5, 4-5-4, 5-4-4) \u0938\u0941\u0938\u0902\u0917\u0924 \u0924\u0941\u0932\u0928\u093e \u0915\u0947 \u0932\u093f\u090f \u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0938\u092a\u094d\u0924\u093e\u0939 \u0905\u0935\u0927\u093f \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964",
    "cost_method": "\u0907\u0928\u094d\u0935\u0947\u0902\u091f\u094d\u0930\u0940 \u0932\u093e\u0917\u0924 \u0915\u0940 \u0917\u0923\u0928\u093e \u0915\u0948\u0938\u0947 \u0939\u094b\u0924\u0940 \u0939\u0948\u0964 \u0914\u0938\u0924: \u092d\u093e\u0930\u093f\u0924 \u092e\u093e\u0927\u094d\u092f\u0964 \u092e\u093e\u0928\u0915: \u092a\u0942\u0930\u094d\u0935\u0928\u093f\u0930\u094d\u0927\u093e\u0930\u093f\u0924 \u0932\u093e\u0917\u0924\u0964 FIFO: \u0938\u092c\u0938\u0947 \u092a\u0941\u0930\u093e\u0928\u093e \u0938\u094d\u091f\u0949\u0915 \u092a\u0939\u0932\u0947\u0964",
    "tax_inclusive_pricing": "\u0938\u0915\u094d\u0937\u092e \u0939\u094b\u0928\u0947 \u092a\u0930, \u0938\u093f\u0938\u094d\u091f\u092e \u092e\u0947\u0902 \u0926\u0930\u094d\u091c \u0915\u093f\u090f \u0917\u090f \u092e\u0942\u0932\u094d\u092f\u094b\u0902 \u092e\u0947\u0902 \u092a\u0939\u0932\u0947 \u0938\u0947 \u0915\u0930 \u0936\u093e\u092e\u093f\u0932 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 EU, \u0911\u0938\u094d\u091f\u094d\u0930\u0947\u0932\u093f\u092f\u093e \u0914\u0930 \u0928\u094d\u092f\u0942\u091c\u093c\u0940\u0932\u0948\u0902\u0921 \u092e\u0947\u0902 \u0906\u092e\u0964",
    "default_tax_rate": "नए दस्तावेज़ों पर लागू डिफ़ॉल्ट कर प्रतिशत। 0 और 100 के बीच।",
    "tax_label": "आपके क्षेत्र में इस कर के लिए उपयोग होने वाला नाम: GST, VAT, IVA, इत्यादि।",
    "default_document_language": "\u091c\u0928\u0930\u0947\u091f \u0915\u093f\u090f \u0917\u090f PDF, \u0907\u0928\u0935\u0949\u0907\u0938 \u0914\u0930 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0915\u0947 \u0932\u093f\u090f \u092d\u093e\u0937\u093e\u0964 \u090f\u0915 \u0932\u094b\u0915\u0947\u0932 \u0915\u094b\u0921 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902 (\u0909\u0926\u093e.: en, de, fr)\u0964",
    "default_paper_size": "\u091c\u0928\u0930\u0947\u091f \u0915\u093f\u090f \u0917\u090f PDF \u0915\u0947 \u0932\u093f\u090f \u0915\u093e\u0917\u091c\u093c \u0906\u0915\u093e\u0930\u0964 A4 \u0935\u093f\u0936\u094d\u0935 \u092d\u0930 \u092e\u0947\u0902 \u092e\u093e\u0928\u0915 \u0939\u0948\u0964 Letter \u0905\u092e\u0947\u0930\u093f\u0915\u093e \u0914\u0930 \u0915\u0928\u093e\u0921\u093e \u092e\u0947\u0902 \u0909\u092a\u092f\u094b\u0917 \u0939\u094b\u0924\u093e \u0939\u0948\u0964",
    "text_direction": "संपूर्ण ऐप इंटरफ़ेस (मेनू, फ़ॉर्म, टेबल) और उत्पन्न दस्तावेज़ों के लिए लेआउट दिशा। RTL अरबी, हिब्रू, फ़ारसी और उर्दू के लिए पूरा लेआउट पलटता है — सहेजते ही तुरंत प्रभावी।"
  },
  "errors": {
    "separator_conflict": "\u0926\u0936\u092e\u0932\u0935 \u0935\u093f\u092d\u093e\u091c\u0915 \u0914\u0930 \u0939\u091c\u093e\u0930 \u0935\u093f\u092d\u093e\u091c\u0915 \u090f\u0915 \u0939\u0940 \u0905\u0915\u094d\u0937\u0930 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u0924\u0947\u0964",
    "digit_grouping_requires_separator": "\u0905\u0902\u0915 \u0938\u092e\u0942\u0939\u0928 \u0915\u0947 \u0932\u093f\u090f \u0939\u091c\u093e\u0930 \u0935\u093f\u092d\u093e\u091c\u0915 \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948\u0964",
    "fiscal_day_exceeds_month": "\u092f\u0939 \u0926\u093f\u0928 \u091a\u092f\u0928\u093f\u0924 \u092e\u093e\u0939 \u092e\u0947\u0902 \u092e\u094c\u091c\u0942\u0926 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964",
    "save_failed": "\u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0938\u0939\u0947\u091c\u0928\u0947 \u092e\u0947\u0902 \u0935\u093f\u092b\u0932\u0964 \u0915\u0943\u092a\u092f\u093e \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964"
