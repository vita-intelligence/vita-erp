{
  "version": 1,
  "name": "All Field Types",
  "description": "Tests every single field type renders correctly",
  "elements": [
    {
      "kind": "field",
      "id": "text_field",
      "type": "text",
      "label": "Text Field",
      "description": "A simple text input",
      "required": false,
      "hidden": false
    },
    {
      "kind": "field",
      "id": "integer_field",
      "type": "integer",
      "label": "Integer Field",
      "description": "Whole numbers only",
      "required": false,
      "hidden": false
